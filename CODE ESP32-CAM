// =====================================================
// 4. PIN KAMERA AI-THINKER ESP32-CAM
// =====================================================
#define PWDN_GPIO_NUM     32
#define RESET_GPIO_NUM    -1
#define XCLK_GPIO_NUM      0
#define SIOD_GPIO_NUM     26
#define SIOC_GPIO_NUM     27

#define Y9_GPIO_NUM       35
#define Y8_GPIO_NUM       34
#define Y7_GPIO_NUM       39
#define Y6_GPIO_NUM       36
#define Y5_GPIO_NUM       21
#define Y4_GPIO_NUM       19
#define Y3_GPIO_NUM       18
#define Y2_GPIO_NUM        5

#define VSYNC_GPIO_NUM    25
#define HREF_GPIO_NUM     23
#define PCLK_GPIO_NUM     22

// =====================================================
// 5. VARIABEL SISTEM & GLOBALS
// =====================================================
bool systemActive = false;
volatile bool newDataArrived = false;

volatile int currentPir = 0;
volatile int currentVibration = 0;
volatile int currentMagnet = 0;

bool threatActive = false;

unsigned long lastTriggerTime = 0;
const unsigned long COOLDOWN_TIME = 10000;

// Buffer foto terakhir & HTTP Server handle
camera_fb_t *lastCapturedFB = NULL;
httpd_handle_t camera_httpd = NULL;

// Blynk Timer
BlynkTimer timer;

// =====================================================
// 6. STRUKTUR DATA ESP-NOW
// =====================================================
typedef struct struct_message {
  int pir;
  int vibration;
  int magnet;
} struct_message;

struct_message sensorData;

// =====================================================
// 7. FUNGSI TIMESTAMP NTP
// =====================================================
String getTimestamp() {
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo, 1000)) {
    return "TIME_NOT_SYNC";
  }

  char timeString[25];
  strftime(timeString, sizeof(timeString), "%Y-%m-%d %H:%M:%S", &timeinfo);
  return String(timeString);
}

// =====================================================
// 8. HTTP SERVER HANDLER
// =====================================================
static esp_err_t photo_handler(httpd_req_t *req) {
  if (lastCapturedFB == NULL) {
    httpd_resp_send_404(req);
    return ESP_FAIL;
  }

  httpd_resp_set_type(req, "image/jpeg");
  httpd_resp_set_hdr(req, "Content-Disposition", "inline; filename=capture.jpg");
  httpd_resp_set_hdr(req, "Access-Control-Allow-Origin", "*");

  return httpd_resp_send(req, (const char *)lastCapturedFB->buf, lastCapturedFB->len);
}

// =====================================================
// 9. START HTTP PHOTO SERVER
// =====================================================
void startCameraServer() {
  httpd_config_t config = HTTPD_DEFAULT_CONFIG();
  config.server_port = 80;

  httpd_uri_t photo_uri = {
    .uri      = "/saved-photo",
    .method   = HTTP_GET,
    .handler  = photo_handler,
    .user_ctx = NULL
  };

  if (httpd_start(&camera_httpd, &config) == ESP_OK) {
    httpd_register_uri_handler(camera_httpd, &photo_uri);
    Serial.println("HTTP Photo Server Berhasil Aktif!");
  } else {
    Serial.println("HTTP Photo Server Gagal Aktif!");
  }
}

// =====================================================
// 10. AMBIL FOTO DAN UPDATE URL BLYNK (WITH LATENCY)
// =====================================================
void ambilFotoDanUpdateURL(unsigned long t0) {
  Serial.printf("[%lu ms] Memproses Pengambilan Foto...\n", millis() - t0);

  // Bebaskan buffer foto sebelumnya jika ada
  if (lastCapturedFB != NULL) {
    esp_camera_fb_return(lastCapturedFB);
    lastCapturedFB = NULL;
  }

  // Ambil foto baru
  lastCapturedFB = esp_camera_fb_get();
  if (lastCapturedFB == NULL) {
    Serial.printf("[%lu ms] Gagal Mengambil Foto!\n", millis() - t0);
    return;
  }

  Serial.printf("[%lu ms] Foto Berhasil Ditangkap!\n", millis() - t0);

  // Endpoint URL Foto unik dengan query millis() mencegah browser caching
  String photoURL = "http://" + WiFi.localIP().toString() + "/saved-photo?t=" + String(millis());

  if (Blynk.connected()) {
    Blynk.virtualWrite(V5, photoURL);
    Serial.printf("[%lu ms] URL Foto Dikirim ke Blynk V5\n", millis() - t0);
  } else {
    Serial.printf("[%lu ms] Blynk Tidak Terhubung! URL Tidak Dikirim.\n", millis() - t0);
  }
}

// =====================================================
// 11. KIRIM NOTIFIKASI ANCAMAN (WITH LATENCY)
// =====================================================
void kirimNotifikasiAncaman(unsigned long t0) {
  if (!Blynk.connected()) {
    Serial.printf("[%lu ms] Blynk tidak terhubung. Notifikasi tidak dapat dikirim.\n", millis() - t0);
    return;
  }

  Blynk.logEvent("ancaman_terdeteksi", "PERINGATAN! Ancaman terdeteksi pada pintu. PIR + Getaran + Magnet aktif.");
  Serial.printf("[%lu ms] Perintah Notifikasi Blynk Dikirim.\n", millis() - t0);
}

// =====================================================
// 12. SERIAL CSV LOGGER
// =====================================================
void printCSVData(int threatStatus) {
  String timestamp = getTimestamp();
  Serial.printf("%s,%d,%d,%d,%d,%d\n",
                timestamp.c_str(),
                currentPir,
                currentVibration,
                currentMagnet,
                systemActive ? 1 : 0,
                threatStatus);
}

// =====================================================
// 13. PEMROSESAN DATA SENSOR & FUSI MULTI-SENSOR
// =====================================================
void processBlynkTasks() {
  if (!newDataArrived) {
    return;
  }
  newDataArrived = false;

  // Logic Fusi Multi-Sensor (Semua 3 sensor aktif simultan)
  bool threatDetected = systemActive && (currentPir == 1) && (currentVibration == 1) && (currentMagnet == 1);
  int threatStatus = threatDetected ? 1 : 0;

  // Logging Serial CSV
  printCSVData(threatStatus);

  // Update Status Telemetri ke Blynk
  if (Blynk.connected()) {
    Blynk.virtualWrite(V1, currentPir);
    Blynk.virtualWrite(V2, currentVibration);
    Blynk.virtualWrite(V3, currentMagnet);
  }

  // Penanganan Kondisi Disarmed (Nonaktif)
  if (!systemActive) {
    threatActive = false;
    if (Blynk.connected()) {
      Blynk.virtualWrite(V4, 0);
    }
    return;
  }

  // Penanganan Kondisi Armed & Ancaman Terdeteksi
  if (threatDetected) {
    if (Blynk.connected()) {
      Blynk.virtualWrite(V4, 1);
    }

    if (!threatActive) {
      threatActive = true;

      // Filter Cooldown Triggering
      if (millis() - lastTriggerTime >= COOLDOWN_TIME) {
        lastTriggerTime = millis();

        // Titik awal eksekusi ancaman (0 ms)
        unsigned long t0 = millis();

        Serial.println("\n=================================");
        Serial.println("ANCAMAN TERDETEKSI!");
        Serial.println("FUSI MULTI-SENSOR = 3/3");
        Serial.println("=================================");

        Serial.printf("[%lu ms] THREAT TERDETEKSI\n", millis() - t0);

        ambilFotoDanUpdateURL(t0);
        kirimNotifikasiAncaman(t0);
        Serial.println(); // Baris baru penutup
      }
    }
  } else {
    threatActive = false;
    if (Blynk.connected()) {
      Blynk.virtualWrite(V4, 0);
    }
  }
}

// =====================================================
// 14. CALLBACK RECEIVE ESP-NOW
// =====================================================
void OnDataRecv(const esp_now_recv_info *info, const uint8_t *incomingData, int len) {
  if (len != sizeof(sensorData)) {
    return;
  }

  memcpy(&sensorData, incomingData, sizeof(sensorData));

  currentPir = sensorData.pir;
  currentVibration = sensorData.vibration;
  currentMagnet = sensorData.magnet;

  newDataArrived = true;
}

// =====================================================
// 15. BLYNK HANDLER - ARM / DISARM (V0)
// =====================================================
BLYNK_WRITE(V0) {
  int value = param.asInt();
  systemActive = (value == 1);
  threatActive = false;

  if (systemActive) {
    Serial.println("SISTEM DI-ARM!");
  } else {
    Serial.println("SISTEM DI-DISARM!");
  }

  if (Blynk.connected()) {
    Blynk.virtualWrite(V4, 0);
  }
}

// =====================================================
// 16. BLYNK HANDLER - MANUAL SNAPSHOT (V6)
// =====================================================
BLYNK_WRITE(V6) {
  if (param.asInt() == 1) {
    Serial.println("Tombol Snapshot ditekan!");
    unsigned long t0 = millis();
    ambilFotoDanUpdateURL(t0);
    Blynk.virtualWrite(V6, 0);
  }
}

// =====================================================
// 17. BLYNK CONNECTED EVENT
// =====================================================
BLYNK_CONNECTED() {
  Serial.println("Blynk Cloud Terhubung!");
  Blynk.syncVirtual(V0);
}

// =====================================================
// 18. SETUP
// =====================================================
void setup() {
  Serial.begin(115200);
  delay(1000);

  Serial.println("\n==============================================");
  Serial.println(" ESP32-CAM SECURITY SYSTEM");
  Serial.println(" MULTI-SENSOR FUSION + BLYNK");
  Serial.println("==============================================");

  // Konfigurasi Pin Kamera
  camera_config_t config;
  config.ledc_channel = LEDC_CHANNEL_0;
  config.ledc_timer   = LEDC_TIMER_0;
  config.pin_d0       = Y2_GPIO_NUM;
  config.pin_d1       = Y3_GPIO_NUM;
  config.pin_d2       = Y4_GPIO_NUM;
  config.pin_d3       = Y5_GPIO_NUM;
  config.pin_d4       = Y6_GPIO_NUM;
  config.pin_d5       = Y7_GPIO_NUM;
  config.pin_d6       = Y8_GPIO_NUM;
  config.pin_d7       = Y9_GPIO_NUM;
  config.pin_xclk     = XCLK_GPIO_NUM;
  config.pin_pclk     = PCLK_GPIO_NUM;
  config.pin_vsync    = VSYNC_GPIO_NUM;
  config.pin_href     = HREF_GPIO_NUM;
  config.pin_sscb_sda = SIOD_GPIO_NUM;
  config.pin_sscb_scl = SIOC_GPIO_NUM;
  config.pin_pwdn     = PWDN_GPIO_NUM;
  config.pin_reset    = RESET_GPIO_NUM;
  config.xclk_freq_hz = 20000000;
  config.pixel_format = PIXFORMAT_JPEG;

  // Cek Keberadaan PSRAM
  if (psramFound()) {
    config.frame_size   = FRAMESIZE_VGA;
    config.jpeg_quality = 10;
    config.fb_count     = 2;
    Serial.println("PSRAM Terdeteksi");
  } else {
    config.frame_size   = FRAMESIZE_VGA;
    config.jpeg_quality = 12;
    config.fb_count     = 1;
    Serial.println("PSRAM Tidak Terdeteksi");
  }

  // Inisialisasi Kamera
  esp_err_t err = esp_camera_init(&config);
  if (err != ESP_OK) {
    Serial.printf("Kamera gagal diinisialisasi! Error: 0x%x\n", err);
  } else {
    Serial.println("Kamera ESP32-CAM Berhasil Siap!");
  }

  // Inisialisasi Wi-Fi Dual Mode (Station + Access Point) untuk ESP-NOW & Blynk
  WiFi.mode(WIFI_AP_STA);
  WiFi.begin(ssid, pass);
  Serial.print("Menghubungkan ke Wi-Fi");

  int timeout = 0;
  while (WiFi.status() != WL_CONNECTED && timeout < 20) {
    delay(500);
    Serial.print(".");
    timeout++;
  }

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\nWi-Fi Terhubung!");
    Serial.print("IP Address ESP32-CAM: ");
    Serial.println(WiFi.localIP());
    Serial.print("Wi-Fi Channel: ");
    Serial.println(WiFi.channel());
  } else {
    Serial.println("\nWi-Fi Gagal Terhubung!");
    return;
  }

  // Sinkronisasi Waktu NTP
  Serial.println("Sinkronisasi waktu NTP...");
  configTime(GMT_OFFSET_SEC, DAYLIGHT_OFFSET_SEC, "pool.ntp.org", "time.nist.gov", "time.google.com");

  struct tm timeinfo;
  int ntpRetry = 0;
  while (!getLocalTime(&timeinfo, 1000) && ntpRetry < 10) {
    Serial.print(".");
    ntpRetry++;
  }

  if (getLocalTime(&timeinfo, 1000)) {
    Serial.println("\nWaktu NTP berhasil disinkronkan.");
    Serial.print("Waktu ESP32-CAM: ");
    Serial.println(getTimestamp());
  } else {
    Serial.println("\nGagal sinkronisasi NTP. Timestamp akan ditampilkan sebagai TIME_NOT_SYNC.");
  }

  // Koneksi Blynk Cloud
  Blynk.config(BLYNK_AUTH_TOKEN);
  Serial.println("Menghubungkan ke Blynk...");
  if (Blynk.connect(10000)) {
    Serial.println("Blynk Cloud Berhasil Terhubung!");
  } else {
    Serial.println("Blynk Cloud Gagal Terhubung!");
  }

  // Inisialisasi HTTP Photo Server & ESP-NOW Receiver
  startCameraServer();

  if (esp_now_init() != ESP_OK) {
    Serial.println("ESP-NOW Gagal Diinisialisasi!");
    return;
  }

  Serial.println("ESP-NOW Berhasil Aktif!");
  Serial.printf("Channel ESP-NOW: %d\n", WiFi.channel());
  esp_now_register_recv_cb(OnDataRecv);

  // Setup Interval Timer Process Tasks
  timer.setInterval(150L, processBlynkTasks);
  Serial.println("Blynk Timer Aktif!");

  // Cetak Header CSV di Serial Monitor
  Serial.println("\n========== CSV DATA ==========");
  Serial.println("Timestamp,PIR,Vibration,Magnet,ARM,THREAT");
  Serial.println("==============================");
  Serial.println("\nSISTEM SIAP DIGUNAKAN!");
}

// =====================================================
// 19. MAIN LOOP
// =====================================================
void loop() {
  // Pengelolaan Reorganisasi Koneksi Blynk
  if (Blynk.connected()) {
    Blynk.run();
  } else {
    static unsigned long lastReconnect = 0;
    if (millis() - lastReconnect >= 5000) {
      lastReconnect = millis();
      Serial.println("Mencoba reconnect Blynk...");
      Blynk.connect(3000);
    }
  }

  // Jalankan Timer Task
  timer.run();
}
